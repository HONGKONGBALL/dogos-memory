      "preconditions": {
        "min_battery": 40,
        "require_operator": true,
        "require_stationary": true,
        "reject_charging": true,
        "require_peer": false
      },
      "max_duration_ms": 25000,
      "steps": [
        {"id": "attention_head", "action": "head", "args": {"pitch": -0.04, "yaw": 0.08, "duration_ms": 800}, "verification": "service_only"},
        {"id": "excited_face", "action": "emotion", "args": {"candidates": ["HAPPY_10S", "happy", "say_hi"], "duration_ms": 1000}, "verification": "service_only"},
        {"id": "excited", "action": "native_dag", "args": {"task_id": "head_basic_up", "source_file": "EXCITED.json"}, "verification": "not_run"},
        {"id": "happy_jump", "action": "native_dag", "args": {"task_id": "HAPPY_BOUNCE", "source_file": "HAPPY_JUMP.json"}, "verification": "not_run"},
        {"id": "welcome_line", "action": "say", "args": {"text": "你回来啦！我等你好久了！"}, "verification": "not_run"},
        {"id": "high_five", "action": "native_dag", "args": {"task_id": "HIGH_FIVE_L", "source_file": "HIGH_FIVE_L.json"}, "verification": "not_run"},
        {"id": "bright_warm_light", "action": "light", "args": {"rgb": [255, 145, 30], "brightness": 50, "duration_ms": 1800}, "verification": "service_only"},
        {"id": "welcome_reset", "action": "head", "args": {"pitch": 0.0, "yaw": 0.0, "duration_ms": 800}, "verification": "service_only"}
      ]
    },
    {
      "id": "xiaoman_comfort_tired",
      "persona": "xiaoman",
      "label": "小满：安静陪伴",
      "triggers": [
        {"kind": "phrase", "value": "我今天有点累"},
        {"kind": "button", "value": "xiaoman_comfort_tired"}
