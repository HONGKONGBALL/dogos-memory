      "preconditions": {
        "min_battery": 35,
        "require_operator": true,
        "require_stationary": true,
        "reject_charging": true,
        "require_peer": false
      },
      "max_duration_ms": 20000,
      "steps": [
        {"id": "safe_listen_tilt", "action": "head", "args": {"pitch": 0.0, "yaw": -0.07, "duration_ms": 800}, "verification": "service_only"},
        {"id": "encouraging_face", "action": "emotion", "args": {"candidates": ["LISTEN", "happy", "WINK"], "duration_ms": 900}, "verification": "service_only"},
        {"id": "listen_tilt", "action": "native_dag", "args": {"task_id": "TILT_HEAD_LISTEN", "source_file": "TILT_HEAD_LISTEN.json"}, "verification": "not_run"},
        {"id": "comfort_line", "action": "say", "args": {"text": "没关系！我陪你，我们一起加油！"}, "verification": "not_run"},
        {"id": "cheer", "action": "native_dag", "args": {"task_id": "cheer_l", "source_file": "CHEER_L.json"}, "verification": "not_run"},
        {"id": "happy_light", "action": "light", "args": {"rgb": [255, 180, 35], "brightness": 48, "duration_ms": 1600}, "verification": "service_only"},
        {"id": "comfort_reset", "action": "head", "args": {"pitch": 0.0, "yaw": 0.0, "duration_ms": 800}, "verification": "service_only"}
      ]
    },
    {
      "id": "xiaoman_meets_buding",
      "persona": "xiaoman",
      "label": "小满：观察后接受布丁",
      "triggers": [
        {"kind": "button", "value": "xiaoman_meets_buding"}
      ],
      "preconditions": {
        "min_battery": 35,
        "require_operator": true,
        "require_stationary": true,
        "reject_charging": true,
        "require_peer": true
      },
      "max_duration_ms": 16000,
      "steps": [
        {"id": "observe_buding", "action": "head", "args": {"pitch": 0.0, "yaw": 0.05, "duration_ms": 700}, "verification": "service_only"},
        {"id": "wait_three_seconds", "action": "wait", "args": {"duration_ms": 3000}, "verification": "not_run"},
        {"id": "accept_line", "action": "say", "args": {"text": "……嗯，今天也一起。"}, "verification": "not_run"},
        {"id": "small_happy", "action": "emotion", "args": {"candidates": ["004_happy_10s", "happy"], "duration_ms": 800}, "verification": "service_only"},
        {"id": "reset_head", "action": "head", "args": {"pitch": 0.0, "yaw": 0.0, "duration_ms": 700}, "verification": "service_only"}
      ]
    },
    {
      "id": "buding_meets_xiaoman",
      "persona": "buding",
      "label": "布丁：主动把小满变成朋友",
      "triggers": [
