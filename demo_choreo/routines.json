      "steps": [
        {"id": "look_to_xiaoman", "action": "head", "args": {"pitch": 0.0, "yaw": 0.08, "duration_ms": 800}, "verification": "service_only"},
        {"id": "friend_face", "action": "emotion", "args": {"candidates": ["say_hi", "happy", "WINK"], "duration_ms": 900}, "verification": "service_only"},
        {"id": "wave_first", "action": "native_dag", "args": {"task_id": "WAVE", "source_file": "WAVE.json"}, "verification": "not_run"},
        {"id": "two_barks", "action": "native_dag", "args": {"task_id": "DOG_BARK", "source_file": "DOG_BARK.json"}, "verification": "not_run"},
        {"id": "friend_line", "action": "say", "args": {"text": "小满！今天也一起玩吧！"}, "verification": "not_run"},
        {"id": "friend_light", "action": "light", "args": {"rgb": [255, 170, 30], "brightness": 50, "duration_ms": 2000}, "verification": "service_only"},
        {"id": "friend_reset", "action": "head", "args": {"pitch": 0.0, "yaw": 0.0, "duration_ms": 800}, "verification": "service_only"}
      ]
    }
  ]
