{
  "schema_version": 2,
  "personas": {
    "xiaoman": {
      "name": "小满",
      "principle": "先确认不会失去，再开始拥有。",
      "tempo": "slow",
      "max_intensity": 0.4,
      "default_brightness": 18
    },
    "buding": {
      "name": "布丁",
      "principle": "世界是好的，所有迎面而来的朋友都值得欢迎。",
      "tempo": "fast",
      "max_intensity": 1.0,
      "default_brightness": 50
    }
  },
  "routines": [
    {
      "id": "xiaoman_show_identity",
      "persona": "xiaoman",
      "label": "小满：谨慎的自我介绍",
      "triggers": [
        {"kind": "phrase", "value": "介绍一下你自己"},
        {"kind": "button", "value": "xiaoman_show_identity"}
      ],
      "preconditions": {
        "min_battery": 20,
        "require_operator": true,
        "require_stationary": true,
        "reject_charging": true,
        "require_peer": false
      },
      "max_duration_ms": 12000,
      "steps": [
        {"id": "observe_first", "action": "wait", "args": {"duration_ms": 1800}, "verification": "not_run"},
        {"id": "look_forward", "action": "head", "args": {"pitch": 0.0, "yaw": 0.03, "duration_ms": 600}, "verification": "service_only"},
        {"id": "identity_line", "action": "say", "args": {"text": "我是小满。让我先看看你。"}, "verification": "not_run"},
        {"id": "identity_light", "action": "light", "args": {"rgb": [28, 58, 78], "brightness": 16, "duration_ms": 900}, "verification": "service_only"},
        {"id": "identity_reset", "action": "head", "args": {"pitch": 0.0, "yaw": 0.0, "duration_ms": 600}, "verification": "service_only"}
      ]
    },
    {
      "id": "buding_show_identity",
      "persona": "buding",
      "label": "布丁：主动的自我介绍",
      "triggers": [
        {"kind": "phrase", "value": "介绍一下你自己"},
        {"kind": "button", "value": "buding_show_identity"}
      ],
      "preconditions": {
        "min_battery": 30,
        "require_operator": true,
        "require_stationary": true,
        "reject_charging": true,
        "require_peer": false
      },
      "max_duration_ms": 15000,
      "steps": [
        {"id": "attention_head", "action": "head", "args": {"pitch": -0.03, "yaw": -0.06, "duration_ms": 700}, "verification": "service_only"},
        {"id": "hello_face", "action": "emotion", "args": {"candidates": ["say_hi", "WINK", "happy"], "duration_ms": 900}, "verification": "service_only"},
        {"id": "self_intro_pose", "action": "native_dag", "args": {"task_id": "SELF_INTRODUCTION", "source_file": "SELF_INTRODUCTION.json"}, "verification": "not_run"},
        {"id": "identity_line", "action": "say", "args": {"text": "我是布丁！见到你就是今天最开心的事！"}, "verification": "not_run"},
        {"id": "identity_light", "action": "light", "args": {"rgb": [255, 150, 40], "brightness": 50, "duration_ms": 1800}, "verification": "service_only"},
        {"id": "identity_reset", "action": "head", "args": {"pitch": 0.0, "yaw": 0.0, "duration_ms": 700}, "verification": "service_only"}
      ]
    },
    {
      "id": "xiaoman_owner_returns",
      "persona": "xiaoman",
      "label": "小满：先确认，再欢迎主人",
      "triggers": [
        {"kind": "phrase", "value": "我回来了"},
        {"kind": "phrase", "value": "我回来啦"},
        {"kind": "button", "value": "xiaoman_owner_returns"}
      ],
      "preconditions": {
        "min_battery": 25,
        "require_operator": true,
        "require_stationary": true,
        "reject_charging": true,
        "require_peer": false
      },
      "max_duration_ms": 14000,
      "steps": [
        {"id": "sample_sound", "action": "head", "args": {"pitch": 0.0, "yaw": 0.05, "duration_ms": 700}, "verification": "service_only"},
        {"id": "confirm_footsteps", "action": "wait", "args": {"duration_ms": 1800}, "verification": "not_run"},
        {"id": "welcome_line", "action": "say", "args": {"text": "……你回来就好。"}, "verification": "not_run"},
        {"id": "small_happy", "action": "emotion", "args": {"candidates": ["004_happy_10s", "HAPPY_10S", "happy"], "duration_ms": 900}, "verification": "service_only"},
        {"id": "low_warm_light", "action": "light", "args": {"rgb": [35, 75, 65], "brightness": 18, "duration_ms": 800}, "verification": "service_only"},
        {"id": "reset_head", "action": "head", "args": {"pitch": 0.0, "yaw": 0.0, "duration_ms": 700}, "verification": "service_only"}
      ]
    },
    {
      "id": "buding_owner_returns",
      "persona": "buding",
      "label": "布丁：全力欢迎主人",
