      "steps": [
        {"id": "quiet_pause", "action": "wait", "args": {"duration_ms": 1000}, "verification": "not_run"},
        {"id": "listen_tilt", "action": "head", "args": {"pitch": 0.0, "yaw": -0.04, "duration_ms": 800}, "verification": "service_only"},
        {"id": "comfort_line", "action": "say", "args": {"text": "……那我陪你坐一会儿。"}, "verification": "not_run"},
        {"id": "calm_light", "action": "light", "args": {"rgb": [24, 48, 78], "brightness": 14, "duration_ms": 1000}, "verification": "service_only"},
        {"id": "comfort_reset", "action": "head", "args": {"pitch": 0.0, "yaw": 0.0, "duration_ms": 800}, "verification": "service_only"}
      ]
    },
    {
      "id": "buding_comfort_tired",
